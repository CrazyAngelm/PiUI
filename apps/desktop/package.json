{
  "name": "@piui/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "PiUI Tauri and Svelte desktop application",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lab": "playwright test",
    "test:lab:prod": "playwright test --project=prod-csp",
    "check:e2e": "tsc -p e2e/tsconfig.json",
    "test:smoke": "node scripts/e2e-smoke.mjs",
    "test:e2e": "node scripts/e2e-platform.mjs",
    "test:e2e:workspace": "node scripts/tauri-webview2-e2e-controller.mjs --workspace",
    "test:e2e:classic": "node scripts/tauri-webview2-e2e-controller.mjs --classic",
    "test:e2e:tauri:windows": "node scripts/tauri-webview2-e2e-controller.mjs",
    "contract:test": "vitest run src/host-api/composerClient.test.ts src/host-api/types.test.ts src/host-api/workspaceContracts.test.ts src/host-api/runtimeSettings.test.ts src/host-api/workspaceLifecycle.test.ts src/host-api/workspaceClient.test.ts src/host-api/orchestrationClient.test.ts src/features/orchestration/systemFile.test.ts src/host-api/scriptTestClient.test.ts src/host-api/extensionUiClient.test.ts src/host-api/triggersContracts.test.ts src/host-api/triggerPatterns.test.ts",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@dagrejs/dagre": "3.1.1",
    "@internationalized/date": "^3.12.4",
    "@lezer/highlight": "1.2.4",
    "@lucide/svelte": "1.48.0",
    "@tauri-apps/api": "2.11.1",
    "@xyflow/svelte": "1.7.0",
    "bits-ui": "2.19.3",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.15.21",
    "ajv": "^8.20.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.3.1",
    "typescript": "5.9.2",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
