{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiUI system file v4",
  "type": "object",
  "properties": {
    "format": {
      "const": "piui-system"
    },
    "version": {
      "const": 4
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "orchestrator": {
      "type": "string",
      "pattern": "\\S"
    },
    "inheritTeamConnections": {
      "type": "boolean"
    },
    "inputs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/definitions/runInput"
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "agent",
              "router"
            ]
          },
          "profile": {
            "$ref": "#/definitions/profile"
          },
          "router": {
            "$ref": "#/definitions/router"
          },
          "task": {
            "type": "string"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "input": {
            "type": "string"
          },
          "executionMode": {
            "enum": [
              "scheduled",
              "callable"
            ]
          },
          "resultFields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "kind": {
                  "enum": [
                    "text",
                    "number",
                    "boolean",
                    "text-list",
                    "artifact"
                  ]
                }
              },
              "required": [
                "name",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "requireApproval": {
            "type": "boolean"
          },
          "condition": {
            "type": "object",
            "properties": {
              "sourceStepId": {
                "type": "string",
                "pattern": "\\S"
              },
              "field": {
                "type": "string",
                "pattern": "\\S"
              },
              "equals": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            },
            "required": [
              "sourceStepId",
              "field",
              "equals"
            ],
            "additionalProperties": false
          },
          "review": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "pattern": "\\S"
              },
              "retryFromStepId": {
                "type": "string",
                "pattern": "\\S"
              },
              "maxIterations": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "required": [
              "field",
              "retryFromStepId"
            ],
            "additionalProperties": false
          },
          "inputBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceStepId": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "field": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "name": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "required": [
                "sourceStepId",
                "field",
                "name"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "profile",
          "task"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "\\S"
          },
          "to": {
            "type": "string",
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "result",
              "send",
              "observe",
              "spawn",
              "route"
            ]
          },
          "branchId": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "from",
          "to",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "version",
    "name",
    "agents",
    "connections"
  ],
  "additionalProperties": false,
  "definitions": {
    "runInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "text",
            "long-text",
            "number",
            "boolean",
            "choice"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "defaultValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "required": [
        "name",
        "label",
        "kind"
      ],
      "additionalProperties": false
    },
    "router": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "program",
            "agent"
          ]
        },
        "inputStepId": {
          "type": "string",
          "pattern": "\\S"
        },
        "selectionField": {
          "type": "string",
          "pattern": "\\S"
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "\\S"
              },
              "label": {
                "type": "string",
                "pattern": "\\S"
              },
              "description": {
                "type": "string"
              },
              "predicate": {
                "$ref": "#/definitions/routerPredicate"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "mode",
        "inputStepId",
        "branches"
      ],
      "additionalProperties": false
    },
    "routerPredicate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "equals"
            },
            "field": {
              "type": "string",
              "pattern": "\\S"
            },
            "value": {
              "anyOf": [
                { "type": "string" },
                { "type": "number" },
                { "type": "boolean" },
                { "type": "null" }
              ]
            }
          },
          "required": [
            "op",
            "field",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "exists"
            },
            "field": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": [
            "op",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "all",
                "any"
              ]
            },
            "predicates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/routerPredicate"
              }
            }
          },
          "required": [
            "op",
            "predicates"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "not"
            },
            "predicate": {
              "$ref": "#/definitions/routerPredicate"
            }
          },
          "required": [
            "op",
            "predicate"
          ],
          "additionalProperties": false
        }
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "harness": {
          "enum": [
            "codex",
            "prime-agent",
            "pi",
            "hermes",
            "claude-code"
          ]
        },
        "model": {
          "type": "string",
          "pattern": "\\S"
        },
        "modelProvider": {
          "type": "string",
          "pattern": "\\S"
        },
        "permissionMode": {
          "enum": [
            "native",
            "read-only",
            "workspace-write",
            "full-access"
          ]
        },
        "networkAccess": {
          "type": "boolean"
        },
        "instructions": {
          "type": "string"
        },
        "baseInstructions": {
          "type": "string"
        },
        "reasoning": {
          "enum": [
            "off",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "serviceTier": {
          "enum": [
            "standard",
            "fast"
          ]
        },
        "toolPolicy": {
          "type": "object",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tool": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "decision": {
                    "enum": [
                      "allow",
                      "deny"
                    ]
                  },
                  "enforcement": {
                    "enum": [
                      "native",
                      "coordinator",
                      "advisory",
                      "unsupported"
                    ]
                  },
                  "mandatory": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "tool",
                  "decision",
                  "enforcement",
                  "mandatory"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "rules"
          ],
          "additionalProperties": false
        },
        "resourceRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "skill",
                  "mcp"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "\\S"
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "id",
              "enabled"
            ],
            "additionalProperties": false
          }
        },
        "whenToCall": {
          "type": "string"
        },
        "inputInstructions": {
          "type": "string"
        },
        "expectedResult": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "harness",
        "model",
        "permissionMode",
        "instructions",
        "toolPolicy"
      ],
      "additionalProperties": false
    }
  }
}
