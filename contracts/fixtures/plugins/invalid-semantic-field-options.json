{
  "schemaVersion": 1,
  "id": "hello",
  "name": "Hello",
  "version": "1.0.0",
  "publisher": "PiUI examples",
  "engines": {
    "piui": ">=0.1.0 <1.0.0"
  },
  "permissions": [
    "commands",
    "ui.settings"
  ],
  "contributes": {
    "commands": [
      {
        "id": "say-hello",
        "title": "Say hello",
        "insertText": "Hello from a plugin!"
      }
    ],
    "settings": [
      {
        "key": "name",
        "label": "Name",
        "type": "text",
        "options": [
          {
            "value": "a",
            "label": "A"
          }
        ]
      }
    ]
  }
}
