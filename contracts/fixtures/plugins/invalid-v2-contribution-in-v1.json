{
  "$schema": "https://schemas.piui.dev/plugin/v2.json",
  "schemaVersion": 1,
  "id": "com.example.status-plugin",
  "name": "Status example",
  "version": "1.0.0",
  "publisher": "Example Co.",
  "description": "A status item, keybindings and a chat renderer.",
  "engines": {
    "piui": ">=0.1.0 <1.0.0"
  },
  "permissions": [
    "commands"
  ],
  "backend": {
    "entry": "backend/main.mjs"
  },
  "ui": {
    "entry": "ui/index.html"
  },
  "contributes": {
    "statusItems": [
      {
        "id": "words",
        "text": "Words"
      }
    ]
  }
}
