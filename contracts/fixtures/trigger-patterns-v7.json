{
  "description": "Shared fixtures for file-change automation patterns (orchestration host v7.2). The Rust host (automation_paths.rs) and the editor (host-api/triggerPatterns.ts) must agree on every entry.",
  "valid": [
    "*.md",
    "README.md",
    "src/**/*.ts",
    "src/**/*.{ts,svelte}",
    "docs/",
    "docs/**",
    "log[0-9].txt",
    "log[!0-9].txt",
    "?.rs",
    "a*b*c",
    "fixtures",
    "[-a].txt",
    "Отчёты/*.md"
  ],
  "invalid": [
    ["", "empty"],
    ["   ", "empty"],
    ["/etc/passwd", "absolute"],
    ["C:/Windows/*.dll", "absolute"],
    ["~/notes.md", "absolute"],
    ["src\\*.ts", "backslash"],
    ["../outside/*", "dot-segment"],
    ["./src/*.ts", "dot-segment"],
    ["src/../x", "dot-segment"],
    ["{a,..}/x", "dot-segment"],
    ["src//a.ts", "empty-segment"],
    ["src/a**.ts", "double-star"],
    ["log[.txt", "bracket"],
    ["log].txt", "bracket"],
    ["log[].txt", "bracket"],
    ["log[!].txt", "bracket"],
    ["log[a-].txt", "bracket"],
    ["log[z-a].txt", "bracket"],
    ["*.{ts", "brace"],
    ["*.{ts}", "brace"],
    ["*.{ts,}", "brace"],
    ["{a,{b,c}}", "brace"],
    ["{src/a,lib}/x", "brace"],
    ["a}b", "brace"],
    ["src//a.{ts", "brace"],
    ["{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}{a,b}.x", "brace"],
    ["a\u0007b", "control"]
  ],
  "matches": [
    ["*.md", "README.md", true],
    ["*.md", "docs/guide/setup.md", true],
    ["*.md", "docs/guide/setup.mdx", false],
    ["fixtures", "tests/fixtures/data.json", true],
    ["src/*.ts", "src/main.ts", true],
    ["src/*.ts", "lib/src/main.ts", false],
    ["src/*.ts", "src/app/main.ts", false],
    ["src/**/*.ts", "src/main.ts", true],
    ["src/**/*.ts", "src/app/deep/main.ts", true],
    ["docs/**", "docs/a.txt", true],
    ["docs/**", "other/docs.txt", false],
    ["src/**/*.{ts,svelte}", "src/app/View.svelte", true],
    ["src/**/*.{ts,svelte}", "src/app/view.js", false],
    ["log[!0-9].txt", "log7.txt", false],
    ["?.rs", "ab.rs", false]
  ]
}
