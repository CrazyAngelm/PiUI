{
  "schemaVersion": 1,
  "id": "cursor",
  "displayName": "Cursor",
  "command": {
    "program": "cursor-agent",
    "args": [
      "acp"
    ]
  },
  "version": {
    "args": [
      "--version"
    ]
  },
  "environment": [
    "CURSOR_API_KEY",
    "CURSOR_AUTH_TOKEN",
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "NO_PROXY"
  ],
  "authHint": "Sign in with Cursor's own flow: run `cursor-agent login` in a terminal. To use an API key instead, allow PiUI to pass CURSOR_API_KEY below.",
  "docsUrl": "https://cursor.com/docs/cli/acp"
}
