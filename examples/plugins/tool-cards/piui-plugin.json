{
  "schemaVersion": 2,
  "id": "example.tool-cards",
  "name": "Tool cards",
  "version": "1.0.0",
  "publisher": "PiUI examples",
  "description": "Shows issue-tracker tool calls in the chat as a small card (a chat renderer, manifest version 2).",
  "engines": { "piui": ">=0.1.0 <1.0.0" },
  "permissions": ["ui.renderer"],
  "ui": { "entry": "ui/index.html" },
  "contributes": {
    "renderers": [
      { "id": "issue", "title": "Issue card", "toolNames": ["create_issue", "update_issue"] }
    ]
  }
}
