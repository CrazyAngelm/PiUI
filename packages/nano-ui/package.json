{
  "name": "@piui/nano-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Nano presentation bundles for authenticated web hosts",
  "scripts": {
    "build": "vite build",
    "build:remote": "vite build --config vite.remote.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.remote.json",
    "test:integration": "pnpm build && playwright test",
    "test:remote:unit": "vitest run --config vitest.remote.config.ts",
    "test:remote": "pnpm build:remote && playwright test --config playwright.remote.config.ts"
  },
  "dependencies": {
    "@lucide/svelte": "1.48.0",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/node": "22.15.21",
    "postcss": "8.5.22",
    "svelte-check": "4.3.1",
    "typescript": "5.9.2",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
